{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "lucid",
  "version": "2.0.0",
  "description": "Create Lucidchart diagrams, find Lucid documents, and eliminate context switching.",
  "author": {
    "name": "Lucid Software",
    "email": "support@lucid.co",
    "url": "https://lucid.co"
  },
  "homepage": "https://help.lucid.co/hc/en-us/articles/42578801807508-Integrate-Lucid-with-AI-tools-using-the-Lucid-MCP-server",
  "repository": "https://github.com/lucidsoftware/lucid-mcp-server",
  "license": "MIT",
  "keywords": [
    "lucid",
    "lucidchart",
    "lucidspark",
    "diagrams",
    "documents",
    "boards",
    "whiteboard",
    "mcp",
    "visual-collaboration",
    "collaboration",
    "flowchart",
    "org-chart",
    "mind-map",
    "sequence-diagram",
    "erd",
    "uml",
    "plantuml",
    "export",
    "sharing",
    "comments"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "brandColor": "#282C33",
        "capabilities": [
          "MCP",
          "Documents",
          "Diagrams",
          "Whiteboarding",
          "Collaboration",
          "Export"
        ],
        "category": "Productivity",
        "composerIcon": "./assets/lucid-cg100bg-whitemark.png",
        "defaultPrompt": [
          "Get me up to speed on a document and provide a summary with key insights.",
          "Turn this code into a diagram that explains how it works.",
          "Update my diagram based on these notes."
        ],
        "developerName": "Lucid Software",
        "displayName": "Lucid",
        "logo": "./assets/lucid-cg100bg-whitemark.png",
        "longDescription": "Simplify your workflow by connecting ChatGPT or Codex to Lucid to generate new Lucidchart diagrams from conversations. Instantly create flowcharts, sequence diagrams, process maps, customer journey maps, and more. You can also search, edit, share, and summarize existing Lucid documents within ChatGPT & Codex. Give ChatGPT & Codex the foundational visual context needed to create code and plan projects without switching tools.",
        "privacyPolicyURL": "https://lucid.co/privacy",
        "screenshots": [
          "./assets/summarize-docs.png",
          "./assets/generate-diagram.png",
          "./assets/edit-diagram.png"
        ],
        "shortDescription": "Diagram & align in Lucidchart",
        "supportURL": "https://lucid.co/contact-us",
        "termsOfServiceURL": "https://lucid.co/tos",
        "websiteURL": "https://lucid.co/"
      }
    }
  }
}
